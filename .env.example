# Generate a private invitation: node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
TEAM_INVITE_CODE=
# Persistent server storage. Never commit this file or its -wal/-shm companions.
TEAM_DB_PATH=data/private/team.sqlite
