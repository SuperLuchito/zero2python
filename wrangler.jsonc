{
  "name": "zero2python-local",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-09",
  "assets": {"directory":"dist/client","binding":"ASSETS","run_worker_first":["/api/*"]},
  "d1_databases": [{"binding":"DB","database_name":"zero2python-local","database_id":"local-only","migrations_dir":"drizzle"}],
  "r2_buckets": [{"binding":"BUCKET","bucket_name":"zero2python-local"}]
}
