{
  "name": "python-terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-sites.mjs",
    "start": "wrangler dev --config wrangler.jsonc",
    "preview": "wrangler dev --config wrangler.jsonc",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "check": "node tests/check.cjs"
  },
  "dependencies": {
    "next": "^15.5.9",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "20.19.11",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "typescript": "5.9.2",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
